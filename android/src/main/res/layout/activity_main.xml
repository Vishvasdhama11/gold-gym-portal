<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Error / Disconnected State View -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        android:background="#0B0F17">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏋️ Gold Gym"
            android:textColor="#F59E0B"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/errorStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to gym server..."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="Retry Connection"
            android:textColor="#0B0F17"
            android:backgroundTint="#F59E0B"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnServerSettings"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="Change Server URL"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E293B"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone" />

</RelativeLayout>
